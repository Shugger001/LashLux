# Public
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional client telemetry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_DEPOSIT_ENABLED=false
NEXT_PUBLIC_DEPOSIT_AMOUNT_GHS=50
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Lash Lux <bookings@yourdomain.com>
ADMIN_NOTIFY_EMAIL=hello@lashlux.com

# Daily booking reminders (Vercel Cron Authorization: Bearer …)
CRON_SECRET=replace_with_long_random_string

# Paystack deposits (GHS). Leave unset to keep free request flow.
PAYSTACK_SECRET_KEY=
